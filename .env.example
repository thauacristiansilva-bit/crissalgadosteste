# Copie este arquivo para .env.local no desenvolvimento.
ADMIN_EMAIL=admin@crissalgados.com
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-por-uma-chave-longa-e-secreta
CLIENT_SESSION_SECRET=outra-chave-longa-para-sessao-dos-clientes

# Google Maps Platform — mapa, busca automática de endereços e geocodificação.
# Chave do navegador: restrinja por Sites/HTTP referrers e pelas APIs usadas no front-end.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Chave PRIVADA do servidor para Google Routes API.
# Não use NEXT_PUBLIC_ neste valor. Restrinja a chave somente à Routes API.
GOOGLE_MAPS_SERVER_API_KEY=

# Agente Windows de impressão automática. Use o mesmo valor no Railway e no agente.
PRINT_AGENT_TOKEN=troque-por-um-token-longo

# Opcional: caminho do banco JSON. Útil ao montar um Volume no Railway.
# DATA_FILE=/data/store.json
# Opcional: diretório persistente das imagens (ex.: volume Railway)
# UPLOAD_DIR=/data/uploads
