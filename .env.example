# SaborFlow — copie para .env.local somente no desenvolvimento.

# Banco PostgreSQL
DATABASE_URL=

# Sessões. Em produção, use valores longos, aleatórios e diferentes.
SESSION_SECRET=
CLIENT_SESSION_SECRET=

# URL pública principal da aplicação.
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Login com Google (Google Identity Services).
# Use o mesmo OAuth 2.0 Client ID do tipo "Aplicativo da Web" no Railway.
# Não é necessário Client Secret para este fluxo de ID Token.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_SERVER_API_KEY=

# Opcional: tiles alternativos de mapa
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Uploads atuais. No Railway com Volume, por exemplo: /data/uploads
UPLOAD_DIR=

# Mercado Pago / billing
BILLING_PROVIDER=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
BILLING_WEBHOOK_MAX_AGE_SECONDS=

# Integrações / WhatsApp Cloud API e worker
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_WORKER_TOKEN=
INTEGRATION_WEBHOOK_ALLOWED_HOSTS=
INTEGRATION_CAMPAIGN_MAX_RECIPIENTS=

# Ambientes de demonstração
DEMO_PUBLIC_MINUTES=
DEMO_TRIAL_DAYS=

# Apenas para scripts legados de bootstrap/importação, quando realmente necessários.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# DATA_FILE=/data/store.json

# Etapa 8 — mídia escalável com Cloudflare R2
# Comece com MEDIA_STORAGE_MODE=local. Depois de criar/configurar o bucket,
# mude para r2 no Railway e faça um redeploy.
MEDIA_STORAGE_MODE=local
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Em produção, prefira um domínio customizado do bucket, ex.: https://media.saborflow.com.br
R2_PUBLIC_BASE_URL=
# Opcional. Se vazio, usa https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Cache curto do cardápio público em memória por réplica (0 desativa).
PUBLIC_STORE_CACHE_TTL_MS=15000

# Pool PostgreSQL por réplica. Lembre que 3 réplicas x 5 conexões = até 15 conexões.
POSTGRES_POOL_MAX=5
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECT_TIMEOUT_MS=5000

# Etapa 10 — domínios automáticos / Cloudflare for SaaS
# Domínio-base para a URL automática de cada empresa: <slug>.appsaborflow.com.br
STOREFRONT_ROOT_DOMAIN=appsaborflow.com.br
NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN=appsaborflow.com.br
# Nunca interpretar estes subdomínios como loja.
STOREFRONT_RESERVED_SUBDOMAINS=www,painel,media,api,admin,origin,customers,fallback

# Cloudflare for SaaS. O Zone ID não é o Account ID.
CLOUDFLARE_ZONE_ID=
# Token privado com permissão SSL and Certificates:Edit apenas na zona appsaborflow.com.br.
CLOUDFLARE_SAAS_API_TOKEN=
# CNAME amigável que os clientes apontam para o SaborFlow.
CLOUDFLARE_SAAS_CNAME_TARGET=customers.appsaborflow.com.br

# Segredo compartilhado entre o Worker Cloudflare e a aplicação Railway.
# Gere um valor longo e aleatório e salve o MESMO valor nos dois ambientes.
SABORFLOW_EDGE_TOKEN=
# No Worker, use SABORFLOW_ORIGIN_HOST=origin.appsaborflow.com.br
