# SaborFlow — copie para .env.local somente no desenvolvimento.

# Banco PostgreSQL
DATABASE_URL=

# Sessões. Em produção, use valores longos, aleatórios e diferentes.
SESSION_SECRET=
CLIENT_SESSION_SECRET=

# URL pública principal da aplicação.
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_SERVER_API_KEY=

# Opcional: tiles alternativos de mapa
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Uploads atuais. No Railway com Volume, por exemplo: /data/uploads
UPLOAD_DIR=

# Mercado Pago / billing
BILLING_PROVIDER=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
BILLING_WEBHOOK_MAX_AGE_SECONDS=

# Integrações / WhatsApp Cloud API e worker
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_WORKER_TOKEN=
INTEGRATION_WEBHOOK_ALLOWED_HOSTS=
INTEGRATION_CAMPAIGN_MAX_RECIPIENTS=

# Ambientes de demonstração
DEMO_PUBLIC_MINUTES=
DEMO_TRIAL_DAYS=

# Apenas para scripts legados de bootstrap/importação, quando realmente necessários.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# DATA_FILE=/data/store.json
